{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "5s-audit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cetvn-5s-db",
      "database_id": "25dfadb1-c781-44b0-aeb8-e8f769fb584d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "cetvn-5s-photos"
    }
  ]
}
