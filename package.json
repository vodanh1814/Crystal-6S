{
  "name": "crystal-5s-audit",
  "private": true,
  "version": "2.10.2",
  "description": "Crystal 5S Audit — Smart Factory Andon & 5S Continuous Improvement System designed by Simon",
  "author": "Simon (https://github.com/vodanh1814)",
  "homepage": "https://5s-audit.cetvn.workers.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/vodanh1814/Crystal-6S.git"
  },
  "keywords": [
    "5s-audit",
    "smart-factory",
    "andon",
    "lean-manufacturing",
    "cloudflare-workers",
    "cloudflare-d1",
    "react",
    "typescript"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply cetvn-5s-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cetvn-5s-db --remote",
    "db:sample:local": "wrangler d1 execute cetvn-5s-db --local --file=seed/sample_areas.sql",
    "db:sample:remote": "wrangler d1 execute cetvn-5s-db --remote --file=seed/sample_areas.sql",
    "deploy": "npm run build && wrangler deploy",
    "setup": "node scripts/auto_setup.mjs",
    "setup:local": "node scripts/auto_setup.mjs --local",
    "setup:cloud": "node scripts/auto_setup.mjs --cloud",
    "build:exe": "node scripts/build_exe.mjs",
    "test": "node --test --experimental-strip-types worker/lib/*.test.ts"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
